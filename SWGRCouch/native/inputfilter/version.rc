// VERSIONINFO for swgr_inputfilter.dll (SWGRCouch). Compiled by build.sh with llvm-rc (no preprocessor), linked
// into the DLL by lld-link.
// SignPath Foundation code signing (CODE-SIGNING-POLICY.md) enforces ProductName = the project name ("SWGRCouch")
// and the same ProductVersion in every build of one release: keep them in sync with the SignPath artifact
// configuration (set up in SignPath). A new DLL version: change FILEVERSION, PRODUCTVERSION and both
// version strings together, and the fixed PE time stamp (SWGR_IF_TIMESTAMP) in build.sh with them.

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3F
FILEFLAGS       0x0
FILEOS          0x40004
FILETYPE        0x2
FILESUBTYPE     0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "swgrcouch@ju.l3s.pw"
            VALUE "FileDescription",  "SWGRCouch input filter (split-screen pad routing for STAR WARS Galactic Racer)"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "swgr_inputfilter"
            VALUE "LegalCopyright",   "MIT License, (c) 2026 jules"
            VALUE "OriginalFilename", "swgr_inputfilter.dll"
            VALUE "ProductName",      "SWGRCouch"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Contact: swgrcouch@ju.l3s.pw. MIT-licensed source: SWGRCouch/native/inputfilter."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
